<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= projectName %> | HTF</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <h1>Hooligan Testing Framework</h1>
      <a href="/">Back to Dashboard</a>
    </header>

    <main>
      <h2>Project: <%= projectName %></h2>

      <button id="run-button">Run tests now</button>
      <p id="run-status"></p>

      <h3>Run History</h3>

      <% if (runs.length === 0) { %>
        <p>No runs found.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Run ID</th>
              <th>Status</th>
              <th>Started</th>
              <th>Duration</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody id="runs-table">
            <% runs.forEach((run) => { %>
              <tr>
                <td><%= run.id %></td>
                <td>
                  <span class="status <%= run.status %>"><%= run.status %></span>
                </td>
                <td><%= run.started_at %></td>
                <td><%= run.duration_ms ?? '' %>ms</td>
                <td><a href="/runs/<%= run.id %>">View</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </main>

    <script>
      const projectName = '<%= projectName %>';
      const button = document.getElementById('run-button');
      const statusText = document.getElementById('run-status');

      async function pollRun(runId) {
        const interval = setInterval(async () => {
          const response = await fetch(`/api/runs/${runId}`);
          const run = await response.json();

          statusText.textContent = `Run status: ${run.status}`;

          if (run.status !== 'running') {
            clearInterval(interval);
            window.location.href = `/runs/${runId}`;
          }
        }, 3000);
      }

      button.addEventListener('click', async () => {
        button.disabled = true;
        statusText.textContent = 'Starting run...';

        const response = await fetch(`/api/projects/${projectName}/runs`, {
          method: 'POST'
        });

        const data = await response.json();

        statusText.textContent = `Run started: ${data.runId}`;
        pollRun(data.runId);
      });
    </script>
  </body>
</html>